# --- Owner authentication (required) ---
# Generate with: npm run hash-password
OWNER_PASSWORD_HASH=
# Optional display name for the owner account
OWNER_NAME=Owner
# Development only: plaintext password (ignored when NODE_ENV=production)
# OWNER_PASSWORD=

# Set to "false" only when serving over plain http on localhost in production mode
# COOKIE_SECURE=true

# --- Storage ---
# Directory for the SQLite database, uploads, poster cache and backups (keep it private)
DATA_DIR=./data

# --- Metadata providers (all optional; manual entry always works) ---
# TMDB v4 read access token (preferred) or v3 API key
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Per-request timeout before falling back to the next provider (ms)
PROVIDER_TIMEOUT_MS=6000
