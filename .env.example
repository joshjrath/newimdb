# --- Owner authentication (required: one of these) ---
# The password you sign in with. On a live site it must be at least 12 characters.
OWNER_PASSWORD=
# Or, instead, a scrypt hash of it (from `npm run hash-password`); used first when set.
# OWNER_PASSWORD_HASH=

# The sign-in cookie is marked Secure automatically when the site is served over https.
# Set true/false only to force it (e.g. a proxy that does not send X-Forwarded-Proto).
# COOKIE_SECURE=true

# --- Storage ---
# Directory for the SQLite database, uploads, poster cache and backups (keep it private).
# On Railway, leave it unset and attach a volume: its mount path is used automatically.
# DATA_DIR=./data

# --- Metadata providers (all optional; manual entry always works) ---
# TMDB v4 read access token (preferred) or v3 API key
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Per-request timeout before falling back to the next provider (ms)
PROVIDER_TIMEOUT_MS=6000
